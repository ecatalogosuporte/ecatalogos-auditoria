# Obrigatório para usar o app: sem estas variáveis, o acesso fica bloqueado.
# Supabase > Project Settings > API: URL e chave publishable (ou anon).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Nunca use uma chave secret ou service_role em variáveis VITE_.

# Integração Força de vendas — somente no servidor, sem prefixo VITE_.
FORCA_API_BASE=https://dev.api.forca-de-vendas.e-catalogos.net
FORCA_API_EMAIL=
FORCA_API_PASSWORD=
FORCA_COMPANY_KEY=2000
# IDs do Supabase Auth autorizados, separados por vírgula.
FORCA_ALLOWED_USER_IDS=
# A tabela de destino é fixa: Tabela de Preços Padrão, ERP erp-feiras.
